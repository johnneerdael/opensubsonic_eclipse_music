ADMIN_PASSWORD=change-me

SUBSONIC_USER=eclipse
SUBSONIC_PASSWORD=
SUBSONIC_API_KEY=

PUBLIC_URL=https://music.example.com
BASE_PATH=/api

# 32-byte key as 64 hex chars. Keep it outside backups.
# If empty, /data/data.key is generated on first boot.
DATA_KEY=

CACHE_MAX_BYTES=1073741824
REFRESH_MINUTES=360
BIND_ADDR=127.0.0.1
TZ=Europe/Brussels
